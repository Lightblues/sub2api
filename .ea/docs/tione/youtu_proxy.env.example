# =============================================================================
# youtu_llm_proxy 凭证文件
# =============================================================================
# 本文件首次启动时会被 entrypoint 从镜像内的 .env.example 拷到
#   /data/sub2api/youtu_proxy/.env
# 之后请在 CFS 上用 Web 终端 / 其他机器挂载 CFS 的方式手动改为真实值。
# 改完后 `supervisorctl restart youtu_proxy` 或整体重启容器即可生效。
# =============================================================================

# 内部 tRPC 服务地址(默认值见 youtu_llm_proxy.py)
YOUTU_LLM_BASE=http://112.65.194.90:8001

# sec_info.username
YOUTU_LLM_USERNAME=

# sec_info.userid
YOUTU_LLM_USERID=

# sec_info.token  ← 必填,否则 /v1/messages 会返回 500
YOUTU_LLM_TOKEN=

# proxy 监听端口(默认 8088,与 supervisord.conf 一致;非必要勿改)
YOUTU_LLM_PROXY_PORT=8088
